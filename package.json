{
  "name": "mago-os",
  "version": "0.0.0",
  "private": true,
  "description": "Mago OS: sistema operacional de agentes para empresas (núcleo aberto).",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=11.22 <12"
  },
  "scripts": {
    "tipos": "pnpm -r --if-present run tipos && tsc -p infra",
    "estilo": "biome check .",
    "estilo:corrigir": "biome check --write .",
    "testes": "vitest run",
    "verificar": "pnpm tipos && pnpm estilo && pnpm testes",
    "local:subir": "node infra/local/local.ts subir",
    "local:zerar": "node infra/local/local.ts zerar",
    "local:parar": "node infra/local/local.ts parar"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
