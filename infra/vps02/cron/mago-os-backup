# Mago OS: backup completo diário às 03:30 UTC (domingo também o semanal, dia 1 também o mensal).
# O registro contínuo das alterações roda sempre, pelo próprio PostgreSQL.
30 3 * * * root /opt/mago-os/bin/backup.sh >> /var/log/mago-os-backup.log 2>&1
# Teste de restauração todo dia 2, às 04:30 UTC, num container separado.
30 4 2 * * root /opt/mago-os/bin/restauracao-teste.sh >> /var/log/mago-os-backup.log 2>&1
