[Unit]
Description=Mago OS: campainha da publicação (só avisa que há versão nova)
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 -I /opt/mago-os/campainha/campainha.py
EnvironmentFile=/opt/mago-os/campainha.env
DynamicUser=yes
RuntimeDirectory=mago-os-campainha
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=64M
Restart=always

[Install]
WantedBy=multi-user.target
