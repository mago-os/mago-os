# Mago OS (produção, M6-05). Os mesmos horários do teste, deslocados 15 minutos para não rodarem juntos.
# Backup completo diário às 03:45 UTC (domingo também o semanal, dia 1 também o mensal).
45 3 * * * root /opt/mago-os-producao/bin/backup.sh >> /var/log/mago-os-producao-backup.log 2>&1
# Teste de restauração toda segunda-feira às 04:45 UTC, num container separado.
45 4 * * 1 root /opt/mago-os-producao/bin/restauracao-teste.sh >> /var/log/mago-os-producao-backup.log 2>&1
# Verificação da auditoria todo dia às 05:15 UTC.
15 5 * * * root /opt/mago-os-producao/bin/auditoria-verificar.sh >> /var/log/mago-os-producao-auditoria.log 2>&1
# Memória, disco e espaço do Backblaze da VPS02 inteira (teste e produção), a cada 5 minutos.
*/5 * * * * root /opt/mago-os-producao/bin/recursos.sh >> /var/log/mago-os-producao-recursos.log 2>&1
